{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2021",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@common/*": [
                "libs/common/src/*"
            ]
        }
    }
}